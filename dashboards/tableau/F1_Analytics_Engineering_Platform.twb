      <column caption='Race Wins' datatype='integer' name='[Calculation_0752112128970759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [FINISHING_POSITION] = 1 THEN [RESULT_KEY] END)' />
